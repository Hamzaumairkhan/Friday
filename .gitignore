# ==============================================================================
# Friday — Complete Project .gitignore
# ==============================================================================

# Environment & Secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.cert
proven-dryad-*.json
service-account*.json

# Dependencies
node_modules/
backend/whatsapp_service/node_modules/
frontend/node_modules/

# Python & Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/
env/

# Databases & Vector Stores
*.db
*.db-journal
*.sqlite
*.sqlite3
data/*.db
data/chroma/*
!data/chroma/.gitkeep
backend/data/*.db
backend/data/chroma/*
!backend/data/chroma/.gitkeep

# WhatsApp Baileys Auth Session & Temp files
backend/whatsapp_service/auth_info_baileys/
backend/whatsapp_service/auth_info/
backend/whatsapp_service/*.log
*.log

# Build & Dist Artifacts
dist/
build/
frontend/dist/
*.egg-info/

# IDE & OS Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Agent IDE metadata
.agents/
.gemini/
