# ==============================================================================
# FRIDAY — AI Travel Copilot & Trusted Marketplace for Pakistan
# Minimal Essential Environment Configuration (.env.example)
# ==============================================================================

# APP CONFIGURATION
APP_NAME=Friday
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# DATABASE (Defaults to backend/data/friday.db automatically)
# DATABASE_URL=sqlite+aiosqlite:///backend/data/friday.db

# LLM 1: PRIMARY FAST ROUTING & EXTRACTION (Groq Cloud)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# LLM 2: PLANNING, REASONING & FALLBACK (Google Gemini)
GOOGLE_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# WEB RESEARCH (Tavily Travel Search)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# WEATHER (OpenWeather API)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MAPS / PLACES (Google Maps Platform or OSM fallback)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# EMAIL NOTIFICATIONS (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
ADMIN_EMAIL=your_admin_email@example.com

# WHATSAPP NOTIFICATIONS (Isolated Baileys local microservice)
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001

# VECTOR STORE PATH (Defaults to backend/data/chroma)
# CHROMA_PATH=./data/chroma

# OPTIONAL OBSERVABILITY (LangSmith)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=friday
