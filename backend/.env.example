# ==============================================================================
# FRIDAY — AI Travel Copilot & Trusted Marketplace for Pakistan
# Production & Development Environment Configuration (.env.example)
# ==============================================================================

# APP CONFIGURATION
APP_NAME=Friday
APP_VERSION=0.1.0
ENVIRONMENT=development    # Set to 'production' on Railway
DEBUG=true                 # Set to false on Railway
HOST=0.0.0.0
PORT=8000                  # Railway automatically injects $PORT

# DATABASE CONFIGURATION
# Development (SQLite Local):
DATABASE_URL=sqlite+aiosqlite:///backend/data/friday.db
DATABASE_SYNC_URL=sqlite:///backend/data/friday.db

# Production (Railway Managed MySQL):
# DATABASE_URL=mysql+asyncmy://root:YOUR_PASSWORD@mysql.railway.internal:3306/railway
# DATABASE_SYNC_URL=mysql+pymysql://root:YOUR_PASSWORD@mysql.railway.internal:3306/railway

# DATABASE POOL SIZING (Per worker process)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# REDIS CONFIGURATION (Railway Managed Redis for Rate Limiting, Idempotency & Caching)
# REDIS_URL=redis://default:YOUR_PASSWORD@redis.railway.internal:6379
DISABLE_RATE_LIMIT=false

# CORS & FRONTEND (Set your Vercel frontend URL on Railway)
# FRONTEND_URL=https://your-friday-app.vercel.app

# LLM 1: PRIMARY FAST ROUTING & EXTRACTION (Groq Cloud)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# LLM 2: PLANNING, REASONING & FALLBACK (Google Gemini)
GOOGLE_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# WEB RESEARCH (Tavily Travel Search)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# WEATHER (OpenWeather API)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# MAPS / PLACES (Google Maps Platform or OSM fallback)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# EMAIL NOTIFICATIONS (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
ADMIN_EMAIL=your_admin_email@example.com

# WHATSAPP NOTIFICATIONS (Isolated Baileys local microservice)
WHATSAPP_SERVICE_URL=http://127.0.0.1:3001

# VECTOR STORE PATH (Defaults to backend/data/chroma)
# CHROMA_PATH=./data/chroma

# OPTIONAL OBSERVABILITY (LangSmith)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=friday
